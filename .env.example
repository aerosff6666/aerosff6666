# Copie para .env e preencha só o que for usar.

# IA (opcional): https://console.anthropic.com
ANTHROPIC_API_KEY=

# TikTok Content Posting API: https://developers.tiktok.com (escopos video.upload / video.publish)
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (conta Profissional ligada a uma Página do Facebook)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_URL=https://graph.facebook.com/v23.0

# Telegram: crie o bot com o @BotFather e adicione-o como admin do grupo/canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Robô do Instagram (webhook): token que você inventa e cadastra no painel do app da Meta,
# e a chave secreta do app (Configurações > Básico) para validar as notificações.
IG_VERIFY_TOKEN=
IG_APP_SECRET=

# Avatar falante (opcional, pago): https://www.heygen.com
HEYGEN_API_KEY=
